diff --git a/apps/screenpipe-app-tauri/lib/personal-local-build.test.ts b/apps/screenpipe-app-tauri/lib/personal-local-build.test.ts
new file mode 100644
index 0000000..013fa6d
--- /dev/null
+++ b/apps/screenpipe-app-tauri/lib/personal-local-build.test.ts
@@ -0,0 +1,23 @@
+import { afterEach, expect, test } from "bun:test";
+import { isFreeOrUnattributedUser, getLocalPlanPolicy } from "./app-entitlement";
+import { workflowAccess } from "./workflows/access";
+const original = process.env.NEXT_PUBLIC_SCREENPIPE_PERSONAL_BUILD;
+afterEach(() => {
+  if (original === undefined) delete process.env.NEXT_PUBLIC_SCREENPIPE_PERSONAL_BUILD;
+  else process.env.NEXT_PUBLIC_SCREENPIPE_PERSONAL_BUILD = original;
+});
+test("personal build unlocks history without inventing a paid account", () => {
+  process.env.NEXT_PUBLIC_SCREENPIPE_PERSONAL_BUILD = "1";
+  expect(isFreeOrUnattributedUser(null)).toBe(false);
+  expect(getLocalPlanPolicy(null)).toBe("unknown");
+  delete process.env.NEXT_PUBLIC_SCREENPIPE_PERSONAL_BUILD;
+  expect(isFreeOrUnattributedUser(null)).toBe(true);
+});
+test("owned workflow provider works without hosted usage or allowance", () => {
+  process.env.NEXT_PUBLIC_SCREENPIPE_PERSONAL_BUILD = "1";
+  expect(workflowAccess(null, "intelligent", true).state).toBe("ready");
+  expect(workflowAccess(null, "intelligent", false).state).toBe("unavailable");
+  expect(workflowAccess(null, "private", false).state).toBe("unavailable");
+  delete process.env.NEXT_PUBLIC_SCREENPIPE_PERSONAL_BUILD;
+  expect(workflowAccess(null, "intelligent", true).state).toBe("unavailable");
+});
