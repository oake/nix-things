+// hid-steam exposes the Puck's raw client as a sibling of the evdev HID device.
+// Pair them by the physical USB interface, which includes the Puck slot.
+static QString steamPuckHidrawNode(const QVariantMap &device)
+{
+    if (device.value(QStringLiteral("vendorId")).toString() != QLatin1String("28de")
+        || device.value(QStringLiteral("productId")).toString() != QLatin1String("1304")
+        || device.value(QStringLiteral("type")).toString() != QLatin1String("controller")) {
+        return {};
+    }
+    const QString event = device.value(QStringLiteral("path")).toString().section(QLatin1Char('/'), -1);
+    QFile name(QStringLiteral("/sys/class/input/%1/device/name").arg(event));
+    if (!name.open(QIODevice::ReadOnly) || name.readAll().trimmed() != "Wireless Steam Controller") {
+        return {};
+    }
+    const QByteArray phys = device.value(QStringLiteral("physPath")).toByteArray();
+    const QString slot = QString::fromLatin1(phys).section(QLatin1Char('/'), -1);
+    if (slot != QLatin1String("input2") && slot != QLatin1String("input3")
+        && slot != QLatin1String("input4") && slot != QLatin1String("input5")) {
+        return {};
+    }
+
+    const QDir hidraw(QStringLiteral("/sys/class/hidraw"));
+    QString result;
+    for (const QString &entry : hidraw.entryList({QStringLiteral("hidraw*")}, QDir::Dirs)) {
+        QFile uevent(hidraw.filePath(entry + QStringLiteral("/device/uevent")));
+        if (!uevent.open(QIODevice::ReadOnly)) {
+            continue;
+        }
+        const auto properties = uevent.readAll().split('\n');
+        if (!properties.contains("HID_ID=0003:000028DE:00001304") || !properties.contains("HID_PHYS=" + phys)) {
+            continue;
+        }
+        const QString node = QStringLiteral("/dev/") + entry;
+        if (!result.isEmpty() || ::access(QFile::encodeName(node).constData(), R_OK | W_OK) != 0) {
+            return {};
+        }
+        result = node;
+    }
+    return result;
+}
+
+static qint64 parentProcess(qint64 pid)
+{
+    QFile stat(QStringLiteral("/proc/%1/stat").arg(pid));
+    if (!stat.open(QIODevice::ReadOnly)) {
+        return 0;
+    }
+    const QByteArray line = stat.readAll();
+    const qsizetype commandEnd = line.lastIndexOf(')');
+    return commandEnd < 0 ? 0 : line.sliced(commandEnd + 2).split(' ').value(1).toLongLong();
+}
+
+// A global udev event does not identify which Steam instance created a pad.
+// Resolve it from a uinput descriptor held by that instance instead.
+static QMap<QString, QString> steamInputOutputs(const QString &processDir, int pidfd, dev_t uinputDevice,
+                                                bool &accessDenied)
+{
+    static const QRegularExpression inputName(QStringLiteral("^input[0-9]+$"));
+    QMap<QString, QString> outputs;
+    const QDir fds(processDir + QStringLiteral("/fd"));
+    for (const QString &entry : fds.entryList(QDir::AllEntries | QDir::System | QDir::NoDotAndDotDot)) {
+        if (QFileInfo(fds.filePath(entry)).symLinkTarget() != QStringLiteral("/dev/uinput")) {
+            continue;
+        }
+        const int fd = static_cast<int>(::syscall(SYS_pidfd_getfd, pidfd, entry.toInt(), 0));
+        if (fd < 0) {
+            accessDenied |= errno == EPERM || errno == EACCES;
+            continue;
+        }
+        struct stat info;
+        char name[64] = {};
+        const bool valid = ::fstat(fd, &info) == 0 && S_ISCHR(info.st_mode) && info.st_rdev == uinputDevice
+            && ::ioctl(fd, UI_GET_SYSNAME(sizeof(name)), name) >= 0;
+        ::close(fd);
+        const QString sysname = QString::fromLatin1(name, strnlen(name, sizeof(name)));
+        if (!valid || !inputName.match(sysname).hasMatch()) {
+            continue;
+        }
+        const QDir device(QStringLiteral("/sys/devices/virtual/input/") + sysname);
+        QFile vendor(device.filePath(QStringLiteral("id/vendor")));
+        QFile product(device.filePath(QStringLiteral("id/product")));
+        if (!vendor.open(QIODevice::ReadOnly) || vendor.readAll().trimmed() != "28de"
+            || !product.open(QIODevice::ReadOnly) || product.readAll().trimmed() != "11ff") {
+            continue;
+        }
+        for (const QString &event : device.entryList({QStringLiteral("event*")}, QDir::Dirs)) {
+            outputs.insert(QStringLiteral("/dev/input/") + event, sysname);
+        }
+    }
+    return outputs;
+}
