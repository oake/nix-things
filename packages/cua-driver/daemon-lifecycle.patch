+#[cfg(unix)]
+struct McpDaemonLifetime {
+    enabled: bool,
+    connected: std::sync::atomic::AtomicBool,
+    clients: std::sync::atomic::AtomicUsize,
+    disconnected: tokio::sync::Notify,
+}
+
+#[cfg(unix)]
+impl McpDaemonLifetime {
+    fn connect(self: &std::sync::Arc<Self>) -> Option<McpDaemonConnection> {
+        if !self.enabled {
+            return None;
+        }
+        self.clients.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        self.connected.store(true, std::sync::atomic::Ordering::SeqCst);
+        Some(McpDaemonConnection(self.clone()))
+    }
+}
+
+#[cfg(unix)]
+struct McpDaemonConnection(std::sync::Arc<McpDaemonLifetime>);
+
+#[cfg(unix)]
+impl Drop for McpDaemonConnection {
+    fn drop(&mut self) {
+        if self.0.clients.fetch_sub(1, std::sync::atomic::Ordering::SeqCst) == 1 {
+            self.0.disconnected.notify_one();
+        }
+    }
+}
 
