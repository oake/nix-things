--- a/libs/cua-driver/rust/crates/cua-driver/src/bundle.rs
+++ b/libs/cua-driver/rust/crates/cua-driver/src/bundle.rs
@@ -86,7 +86,22 @@

 #[cfg(target_os = "macos")]
 pub fn app_bundle_path() -> String {
-    format!("/Applications/{}.app", app_name())
+    std::env::current_exe()
+        .ok()
+        .and_then(|path| std::fs::canonicalize(path).ok())
+        .and_then(|path| containing_app_bundle(&path).map(Path::to_path_buf))
+        .map(|path| path.to_string_lossy().into_owned())
+        .unwrap_or_else(|| format!("/Applications/{}.app", app_name()))
+}
+
+#[cfg(target_os = "macos")]
+fn containing_app_bundle(executable: &Path) -> Option<&Path> {
+    executable.ancestors().find(|path| {
+        matches!(
+            path.file_name().and_then(|name| name.to_str()),
+            Some("CuaDriver.app" | "CuaDriverLocal.app")
+        )
+    })
 }

