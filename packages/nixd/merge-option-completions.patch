+/// Add an option completion item, or merge it into an identical item that
+/// another option set already produced. \p Detail is the item detail without
+/// its origin; merged items list every origin, e.g. "nixos | darwin | bool".
+/// Not size-limited: every set must be merged before the list is truncated.
+void addOptionItem(std::vector<CompletionItem> &Items, CompletionItem Item,
+                   const std::string &Origin, const std::string &Detail) {
+  const std::string Suffix = Detail.empty() ? "" : " | " + Detail;
+  for (CompletionItem &Existing : Items) {
+    if (Existing.label != Item.label || Existing.kind != Item.kind ||
+        Existing.insertText != Item.insertText ||
+        Existing.documentation.has_value() != Item.documentation.has_value())
+      continue;
+    if (Existing.documentation &&
+        Existing.documentation->value != Item.documentation->value)
+      continue;
+    const std::string &D = Existing.detail;
+    if (!llvm::StringRef(D).ends_with(Suffix))
+      continue;
+    Existing.detail =
+        D.substr(0, D.size() - Suffix.size()) + " | " + Origin + Suffix;
+    return;
+  }
+  Item.detail = Origin + Suffix;
+  Items.emplace_back(std::move(Item));
+}
